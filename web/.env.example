# Postgres connection (master database). Fill these in and copy to .env
PGHOST=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=glasgow_archery_league

# DuckDB mirror path (relative to web/). The Quarto site reads this file.
DUCKDB_PATH=../data/data.db

# Server port (Vite proxies /api here)
PORT=5050

# Frontend API base
VITE_API_URL=/api
